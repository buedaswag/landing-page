#!/bin/sh

echo "🔄 Pre-push: rebuild production artifact + test..."

docker compose down
docker compose run --rm --service-ports -d web sh -c "npm run build && npm run preview -- --host 0.0.0.0 --port 4444"

PRE_PUSH=1 python -m unittest discover tests/

test_exit_code=$?

echo "🔄 Switching back to dev mode..."
docker compose down
docker compose up -d

if [ $test_exit_code -ne 0 ]; then
    echo "❌ Tests failed. Push blocked."
    exit 1
fi

echo "✅ All checks passed!"
exit 0
