#!/bin/sh
# A commit is a local save point; a push is the release boundary -- deploy.yml
# fires on push to main. So the suite REPORTS here and BLOCKS in pre-push.
#
# Blocking the commit prevented no defect that pre-push and CI did not already
# catch. All it did was grow the uncommitted worktree: worse to review, worse to
# bisect, nothing to roll back to, and much worse with several agents trying to
# checkpoint into the same tree.
#
# This is not an invitation to --no-verify. The point is the opposite -- remove
# the reason to reach for it. Nothing below blocks that pre-push will not block.
#
# Still blocking: the lockfile policy in `ensure_server.py pre-commit`. That one
# is about the content of *this* commit (audit fix rewrote package-lock.json and
# you have not staged it), it is deterministic, and it costs nothing.
python scripts/ensure_server.py pre-commit || exit 1

python -m unittest discover tests/ && exit 0

# Advisory red goes stale fast -- a failure that scrolls past on every commit
# becomes wallpaper. Say plainly that this is temporary and where it turns hard.
cat <<'EOF'

################################################################################
##                                                                            ##
##   TESTS FAILED -- commit allowed, PUSH WILL BLOCK                          ##
##                                                                            ##
##   Failure output is above. `git push` runs the same suite against a clean  ##
##   preview build and will reject this until it is green.                    ##
##                                                                            ##
################################################################################

EOF
exit 0
