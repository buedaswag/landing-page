---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Lean Coffee Sessions - Miguel Dias">
  <main class="pb-8">
    <article class="max-w-3xl mx-auto px-4 py-8 md:py-12">
      <a href="/" class="text-[rgb(67,97,238)] hover:underline font-medium mb-8 inline-block">← Home</a>

      <!-- Hero: headline + description + cover as one unit -->
      <header class="mb-10">        <img
          src="/images/lean-coffee/cover.png"
          alt="Lean Coffee session"
          data-lean-coffee="cover"
          class="w-full rounded-xl shadow-lg object-cover aspect-[16/9]"
        />
      </header>

      <!-- Description + CTA side by side -->
      <div class="grid grid-cols-2 gap-4 mb-16">
        <div class="rounded-xl bg-[rgb(240,242,245)] p-6 flex flex-col justify-center">
          <p class="text-xl text-gray-600 font-medium mb-3">What's on your mind lately?</p>
          <p class="text-base text-gray-700 leading-relaxed">
            Join us on a Monday for a lightly facilitated conversation, the topics of which we'll decide together on the call.
          </p>
        </div>
        <div class="rounded-xl bg-[rgb(33,48,118)] p-6 flex flex-col justify-center text-center" data-lean-coffee="signup" data-track-lean-coffee="signup">
          <h2 class="text-2xl font-bold text-white mb-2">Get on the List</h2>
          <p class="text-blue-200 text-sm mb-4">Subscribe to my <a href="https://valuestreammapping.substack.com" target="_blank" rel="noopener noreferrer" class="text-white underline decoration-blue-300/50 underline-offset-2 hover:decoration-white transition-colors">Substack</a> and receive the invite for the next session.</p>
          <div data-supascribe-embed-id="975922848385" data-supascribe-subscribe></div>
        </div>
      </div>

      <!-- Communities: credibility, below the CTA -->
      <section class="mb-4">
        <h2 class="text-2xl font-bold text-[rgb(33,48,118)] mb-4 text-center">Our Communities</h2>
        <div class="grid grid-cols-2 gap-4">
          <a href="https://flowcollective.org/" target="_blank" rel="noopener noreferrer" data-track-lean-coffee="flow-collective" class="flex flex-col rounded-xl border border-gray-200 bg-[rgb(240,242,245)] p-6 hover:shadow-md transition-shadow">
            <div class="h-10 flex items-center mb-4">
              <img src="/images/lean-coffee/flow-collective-logo.png" alt="The Flow Collective" class="h-14 w-52 object-contain invert" />
            </div>
            <p class="text-gray-700 text-sm">A private peer network for professionals passionate about improving flow across organizations.</p>
          </a>
          <a href="https://www.flowtopia.io/feed" target="_blank" rel="noopener noreferrer" data-track-lean-coffee="flowtopia" class="flex flex-col rounded-xl border border-gray-200 bg-[rgb(240,242,245)] p-6 hover:shadow-md transition-shadow">
            <div class="h-10 flex items-center mb-4">
              <img src="/images/lean-coffee/Flowtopia.png" alt="Flowtopia" class="h-10 w-40 object-contain rounded-xl" />
            </div>
            <p class="text-gray-700 text-sm">The community for flow and value stream professionals and practitioners to connect, learn, grow and flow.</p>
          </a>
        </div>
      </section>

    </article>
  </main>
  <script src="https://js.supascribe.com/v1/loader/6CvvJKEsgFUXoxLcTzMXdjdkUF43.js" async></script>
</Layout>
