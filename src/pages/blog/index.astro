---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import BlogPostPreview from '../../components/BlogPostPreview.astro';
import ResourceCards from '../../components/ResourceCards.astro';

const posts = (await getCollection('posts')).filter((p) => !p.data.draft);
const sortedPosts = posts.sort((a, b) =>
  new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);
const base = import.meta.env.BASE_URL || '/';
---

<Layout title="Miguel Dias – Blog">
  <main>
    <!-- Start Here section -->
    <section class="py-12 px-4 bg-[#001C46]" data-start-here>
      <div class="max-w-6xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-bold text-center mb-8 text-white">Start Here</h2>
        <ResourceCards />
      </div>
    </section>

    <div class="blog-container">
      <section class="posts" data-posts>
        {sortedPosts.map((post) => (
          <BlogPostPreview
            base={base}
            title={post.data.title}
            description={post.data.description}
            date={post.data.date}
            url={`/blog/${post.id.replace(/\.mdx?$/, '')}`}
            image={post.data.image}
          />
        ))}
      </section>
    </div>
  </main>
</Layout>

<style>
  .blog-container {
    width: 100%;
    max-width: 65rem;
    margin: 0 auto;
    padding: 4rem 1rem;
  }

  .posts {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
</style>
