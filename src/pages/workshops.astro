---
import Layout from '../layouts/Layout.astro';

const FLOWTOPIA_SESSION_1_URL = "https://www.flowtopia.io/c/events/introduction-to-value-stream-mapping";
const FLOWTOPIA_SESSION_2_URL = "https://www.flowtopia.io/c/events/introduction-to-value-stream-mapping-46f1c6";
const CALENDLY_URL = "https://calendly.com/migueldiaseu";
---

<Layout title="Flowtopia VSM Workshops - Miguel Dias">
  <main>
    <section class="py-24 px-4 bg-white">
      <div class="max-w-4xl mx-auto">
        <h1 class="text-4xl md:text-5xl font-bold mb-4 text-[rgb(33,48,118)]">
          Flowtopia VSM Workshops
        </h1>
        <p class="text-lg text-gray-600 mb-12">
          Hands-on Value Stream Mapping sessions for engineering and product leaders. From a 1h intro to a full 5-session facilitation training.
        </p>

        <!-- 1h Intro to VSM - Public sessions -->
        <div class="mb-16">
          <h2 class="text-2xl md:text-3xl font-bold mb-4 text-[rgb(33,48,118)]">
            1h Intro to Value Stream Mapping
          </h2>
          <p class="text-gray-600 mb-6">
            Map and measure a delivery workflow, identify bottlenecks, and apply lean principles in this hands-on 1h workshop. Hosted by Flowtopia.
          </p>
          <div class="grid md:grid-cols-2 gap-6">
            <div class="bg-[rgb(240,242,245)] p-6 rounded-lg">
              <h3 class="font-bold text-[rgb(33,48,118)] mb-2">Session 1</h3>
              <a
                href={FLOWTOPIA_SESSION_1_URL}
                target="_blank"
                rel="noopener noreferrer"
                data-workshop-session="1"
                data-track-workshop-register="workshops-session-1"
                class="inline-block bg-[rgb(67,97,238)] hover:bg-[rgb(67,97,238)]/90 text-white font-bold py-3 px-6 rounded-lg transition-colors"
              >
                Register on Flowtopia
              </a>
            </div>
            <div class="bg-[rgb(240,242,245)] p-6 rounded-lg">
              <h3 class="font-bold text-[rgb(33,48,118)] mb-2">Session 2</h3>
              <a
                href={FLOWTOPIA_SESSION_2_URL}
                target="_blank"
                rel="noopener noreferrer"
                data-workshop-session="2"
                data-track-workshop-register="workshops-session-2"
                class="inline-block bg-[rgb(67,97,238)] hover:bg-[rgb(67,97,238)]/90 text-white font-bold py-3 px-6 rounded-lg transition-colors"
              >
                Register on Flowtopia
              </a>
            </div>
          </div>
        </div>

        <!-- 5 Session VSM Training -->
        <div class="mb-16">
          <h2 class="text-2xl md:text-3xl font-bold mb-4 text-[rgb(33,48,118)]">
            5 Session VSM & Flow Engineering Facilitation Training
          </h2>
          <p class="text-gray-600 mb-6">
            Learn how to prepare and facilitate a full VSM workshop using Flow Engineering. Coming soon for public cohorts. For private training for your team, get in touch.
          </p>
          <div class="bg-[rgb(240,242,245)] p-6 rounded-lg">
            <p class="text-gray-700 mb-4">
              <strong>Coming soon</strong> — Contact for private training.
            </p>
            <a
              href={CALENDLY_URL}
              target="_blank"
              rel="noopener noreferrer"
              data-workshop-private="true"
              data-track-book-call="workshops-private"
              class="inline-block bg-[rgb(67,97,238)] hover:bg-[rgb(67,97,238)]/90 text-white font-bold py-3 px-6 rounded-lg transition-colors"
            >
              Book a Call for Private Training
            </a>
          </div>
        </div>

        <p class="text-gray-600">
          Questions? <a href="/contact" class="text-[rgb(67,97,238)] hover:underline">Get in touch</a> or <a href="https://calendly.com/migueldiaseu" target="_blank" rel="noopener noreferrer" data-track-book-call="workshops-bottom" class="text-[rgb(67,97,238)] hover:underline">book a call</a>.
        </p>
      </div>
    </section>
  </main>
</Layout>
