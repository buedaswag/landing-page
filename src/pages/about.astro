---
import Layout from '../layouts/Layout.astro';
---

<Layout title="About - Miguel Dias">
  <main>
    <!-- About Me Section -->
    <section class="py-20 px-4 bg-white">
      <div class="max-w-4xl mx-auto">
        <!-- Profile Image -->
        <div class="flex justify-center items-center mb-8">
          <div class="flex flex-col items-center">
            <div class="w-48 h-48 rounded-full overflow-hidden mb-4 mx-auto">
              <img
                src="/images/about/profile-helsinki-1000.png"
                alt="Miguel Dias"
                class="w-full h-full object-cover object-[center_35%]"
              />
            </div>
            <h1 class="text-2xl font-bold text-[rgb(33,48,118)] text-center">Miguel Dias - DevOps Consultant</h1>
          </div>
        </div>

        <div class="text-gray-600 space-y-6 max-w-2xl mx-auto">
          <p>
            I'm a Software Engineer with over five years of experience, building and scaling systems for large companies, startups, and a nonprofit.
          </p>
          <p>
            I spent 2024 leading Value Stream Mapping initiatives at Relex, a global SaaS company, involving individual teams, multiple teams, and an entire technology department.
          </p>
          <p>
            I've partnered with these teams to increase revenue by onboarding customers faster, preventing service disruptions, delivering value more often, and wasting less time.
          </p>
          <p>
            A thought leader in the Value Stream Mapping and DevOps space, I'm actively engaged with the international community, and currently launching my own consultancy in Berlin.
          </p>


        </div>
      </div>
    </section>

    <!-- Call to Action Section -->
    <section class="py-14 px-4 bg-[rgb(67,97,238)]">
      <div class="max-w-4xl mx-auto text-center">
        <a href="https://calendly.com/migueldiaseu" target="_blank" rel="noopener noreferrer" data-track-book-call="about" class="inline-block bg-white hover:bg-white/90 text-[rgb(67,97,238)] font-bold py-3 px-8 rounded-lg text-lg transition-colors">
          Book a Call
        </a>
      </div>
    </section>
  </main>
</Layout>
