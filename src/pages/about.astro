---
import Layout from '../layouts/Layout.astro';
---

<Layout title="About - Miguel Dias">
  <main>
    <!-- What I Help You Achieve Section -->
    <section class="bg-[rgb(240,242,245)] -mt-[72px]">
      <div class="max-w-4xl mx-auto px-4 py-20 pt-[92px]">
        <h2 class="text-4xl md:text-5xl font-bold mb-8 text-[rgb(33,48,118)] text-center">What I Help You Achieve</h2>

        <div class="grid md:grid-cols-2 gap-8">
          <div class="flex gap-6 items-start">
            <div class="flex-shrink-0 w-12 h-12 text-[rgb(67,97,238)]">
              <svg class="w-12 h-12" fill="currentColor" viewBox="0 0 24 24">
                <path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 14l-5-5 1.41-1.41L11 13.17l6.59-6.59L19 8l-7 9z"/>
              </svg>
            </div>
            <div>
              <h3 class="text-xl font-bold mb-3 text-[rgb(33,48,118)]">Improve Your Release Process</h3>
              <p class="text-gray-600">Identify bottlenecks, handoffs, dependencies, and address them for smoother, more predictable releases.</p>
            </div>
          </div>

          <div class="flex gap-6 items-start">
            <div class="flex-shrink-0 w-12 h-12 text-[rgb(67,97,238)]">
              <svg class="w-12 h-12" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z"/>
              </svg>
            </div>
            <div>
              <h3 class="text-xl font-bold mb-3 text-[rgb(33,48,118)]">Deliver Reliable, High-Quality Software</h3>
              <p class="text-gray-600">Build quality at the source and minimize defects before they reach customers.</p>
            </div>
          </div>

          <div class="flex gap-6 items-start">
            <div class="flex-shrink-0 w-12 h-12 text-[rgb(67,97,238)]">
              <svg class="w-12 h-12" fill="currentColor" viewBox="0 0 24 24">
                <path d="M11.8 10.9c-2.27-.59-3-1.2-3-2.15 0-1.09 1.01-1.85 2.7-1.85 1.78 0 2.44.85 2.5 2.1h2.21c-.07-1.72-1.12-3.3-3.21-3.81V3h-3v2.16c-1.94.42-3.5 1.68-3.5 3.61 0 2.31 1.91 3.46 4.7 4.13 2.5.6 3 1.48 3 2.41 0 .69-.49 1.79-2.7 1.79-2.06 0-2.87-.92-2.98-2.1h-2.2c.12 2.19 1.76 3.42 3.68 3.83V21h3v-2.15c1.95-.37 3.5-1.5 3.5-3.55 0-2.84-2.43-3.81-4.7-4.4z"/>
              </svg>
            </div>
            <div>
              <h3 class="text-xl font-bold mb-3 text-[rgb(33,48,118)]">Release Often and Stay Competitive</h3>
              <p class="text-gray-600">Improving work saves time and compounds over time, freeing up your teams to deliver value and stay ahead of the competition.</p>
            </div>
          </div>

          <div class="flex gap-6 items-start">
            <div class="flex-shrink-0 w-12 h-12 text-[rgb(67,97,238)]">
              <svg class="w-12 h-12" fill="currentColor" viewBox="0 0 24 24">
                <path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zM9 17H7v-7h2v7zm4 0h-2V7h2v10zm4 0h-2v-4h2v4z"/>
              </svg>
            </div>
            <div>
              <h3 class="text-xl font-bold mb-3 text-[rgb(33,48,118)]">Align Teams on Shared Goals</h3>
              <p class="text-gray-600">Set clear metrics for customer value. Everyone knows what success looks like and how to achieve it.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Call to Action Section -->
    <section class="py-14 px-4 bg-[rgb(67,97,238)]">
      <div class="max-w-4xl mx-auto text-center">
        <a href="https://calendly.com/migueldiaseu" target="_blank" rel="noopener noreferrer" class="inline-block bg-white hover:bg-white/90 text-[rgb(67,97,238)] font-bold py-3 px-8 rounded-lg text-lg transition-colors">
          Let's Talk About Improvements
        </a>
      </div>
    </section>

    <!-- About Me Section -->
    <section class="py-20 px-4 bg-white">
      <div class="max-w-4xl mx-auto">
        <!-- Profile Image -->
        <div class="flex justify-center mb-8">
          <div class="text-center">
            <div class="w-48 h-48 rounded-full overflow-hidden mb-4">
              <img
                src="/images/about/profile-helsinki-1000.png"
                alt="Miguel Dias"
                class="w-full h-full object-cover object-[center_35%]"
              />
            </div>
            <h1 class="text-2xl font-bold text-[rgb(33,48,118)]">Miguel Dias - DevOps Consultant</h1>
          </div>
        </div>

        <div class="text-gray-600 space-y-6 max-w-2xl mx-auto">
          <p class="text-center">
            I’m a Software Engineer with over five years of experience, building and scaling systems for large companies, startups, and a nonprofit.
          </p>
          <p class="text-center">
            I spent 2024 leading Value Stream Mapping initiatives at Relex, a global SaaS company, involving individual teams, multiple teams, and an entire technology department.
          </p>
          <p class="text-center">
            I’ve partnered with these teams to increase revenue by onboarding customers faster, preventing service disruptions, delivering value more often, and wasting less time.
          </p>
          <p class="text-center">
            A thought leader in the Value Stream Mapping and DevOps space, I’m actively engaged with the international community, and currently launching my own consultancy in Berlin.
          </p>

          <h2 class="text-2xl font-bold text-[rgb(33,48,118)] mt-12 mb-6 text-center">Why Value Stream Mapping?</h2>
          <ul class="list-disc list-inside space-y-3 max-w-xl mx-auto">
            <li>Focuses on value delivered to the customer from day 1</li>
            <li>Aligns teams on shared goals that they co-create</li>
            <li>Removes stressful and boring work</li>
            <li>Teams see problems from each others perspective</li>
            <li>Measurable goals give purpose to improvements</li>
            <li>Teams create and own the improvement roadmap</li>
          </ul>
        </div>
      </div>
    </section>
  </main>
</Layout>
