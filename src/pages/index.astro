---
import Layout from '../layouts/Layout.astro';
import ResourceCards from '../components/ResourceCards.astro';

const testimonials = [
  {
    name: "Jukka Palosaari",
    role: "Director of Engineering, Relex Solutions",
    postSlug: "2025-02-19-jukka-palosaari-testimonial",
    quote: "Miguel organized everything for us, we just had to join the workshops and <strong>get immediate value from them</strong>. We invested a bit, but <strong>the outcome is huge</strong>. Even if no further actions are taken, simply doing the workshops shows you what the bottlenecks are, what's slowing you down, and what is hurting the processes.",
  },
  {
    name: "Iker Garagarza",
    role: "Director of Engineering, Relex Solutions",
    postSlug: "2025-02-17-iker-garagarza-testimonial",
    quote: "All the workshops <strong>led us to the outcome we were expecting</strong> and got a good overview on areas we could improve to make the whole process more efficient. It was great to see the whole process, Miguel's facilitation skills as well as his VSM expertise.",
  },
  {
    name: "Mark Sadler",
    role: "Program Director, Relex Solutions",
    postSlug: "2025-03-06-mark-sadler-testimonial",
    quote: "I always found Miguel excellent to work with and <strong>he added value whenever he was involved</strong>. He was always passionate with a great drive and took ownership of the work he was responsible for. He <strong>communicated very well with stakeholders at all levels</strong> and led meetings confidently and in a very organised manner.",
  },
  {
    name: "Mika Schafroth",
    role: "Director of Engineering, Relex Solutions",
    postSlug: "2025-02-17-mika-schafroth-testimonial",
    quote: "The value stream mapping Miguel organized for our Identity Service team had several impacts. On one side, <strong>a tremendous potential was unveiled</strong> how the process of deploying changes can be improved. On the other, it was <strong>a great team building exercise</strong>.",
  }
];
---

<Layout title="Miguel Dias - DevOps & Value Stream Mapping">
  <main>
    <!-- Hero + Work With Me: one flow, no banding -->
    <section id="offerings" class="py-16 md:py-24 px-4 bg-white text-[rgb(33,48,118)]">
      <div class="max-w-6xl mx-auto">
        <!-- Hero: headline + subtitle only, optional small Book a call -->
        <div class="text-center mb-14 md:mb-16">
          <h1 class="text-4xl md:text-6xl font-bold mb-4">
            Improve Your Software<br />
            Delivery
          </h1>
          <p class="text-lg md:text-xl text-[rgb(33,48,118)]/90 max-w-2xl mx-auto">
            Helping teams deliver software faster and with higher quality with Value Stream Mapping and DevOps.
          </p>
        </div>

        <!-- Social proof band -->
        <div data-social-proof class="flex flex-col md:flex-row items-center justify-center gap-4 md:gap-8 mb-10 md:mb-12 text-center md:text-left">
          <a href="/blog/2025-02-17-mika-schafroth-testimonial" data-testimonial="mika-schafroth" class="text-sm text-gray-600 italic max-w-md hover:opacity-80 transition-opacity">
            "A tremendous potential was unveiled how the process of deploying changes can be improved."
            <span class="block not-italic font-semibold text-[rgb(33,48,118)] mt-1">&mdash; Mika Schafroth, Director of Engineering (Relex Solutions)</span>
          </a>
          <div class="flex flex-wrap justify-center gap-3">
            <span class="inline-block bg-[rgb(240,242,245)] text-[rgb(33,48,118)] font-semibold text-sm px-3 py-1.5 rounded-full">64% lead time reduction</span>
            <span class="inline-block bg-[rgb(240,242,245)] text-[rgb(33,48,118)] font-semibold text-sm px-3 py-1.5 rounded-full">Monthly &rarr; Weekly deployments</span>
          </div>
        </div>

        <!-- Service cards: clear CTAs by intent -->
        <div class="grid md:grid-cols-2 gap-6 md:gap-8 max-w-4xl mx-auto">
          <a
            href="/workshops/intro"
            data-offering="short-workshop"
            data-track-offering="short-workshop"
            class="block bg-[rgb(240,242,245)] rounded-xl overflow-hidden hover:shadow-md transition-shadow border border-transparent hover:border-[rgb(67,97,238)]/20 group"
          >
            <img src="/images/workshops/image3.jpg" alt="VSM intro workshop" class="w-full h-[130px] object-cover" />
            <div class="p-6 md:p-8">
              <p class="text-sm font-medium text-[rgb(67,97,238)] mb-2">1h30 training</p>
              <h3 class="text-xl font-bold text-[rgb(33,48,118)] mb-3 group-hover:text-[rgb(67,97,238)] transition-colors">Introduction to Value Stream Mapping for Leaders</h3>
              <p class="text-gray-600 mb-6">Map your delivery, spot bottlenecks, leave with a plan. Hands-on session for engineering and product leaders.</p>
              <span data-cta class="inline-block bg-[rgb(67,97,238)] hover:bg-[rgb(67,97,238)]/90 text-white font-semibold py-2 px-4 rounded-lg text-sm transition-colors">Learn more</span>
            </div>
          </a>
          <a
            href="/workshops/facilitation"
            data-offering="facilitation-training"
            data-track-offering="facilitation-training"
            class="block bg-[rgb(240,242,245)] rounded-xl overflow-hidden hover:shadow-md transition-shadow border border-transparent hover:border-[rgb(67,97,238)]/20 group"
          >
            <img src="/images/workshops/image2.jpg" alt="VSM facilitation workshop" class="w-full h-[130px] object-cover" />
            <div class="p-6 md:p-8">
              <p class="text-sm font-medium text-[rgb(67,97,238)] mb-2">5 sessions &times; 1h30</p>
              <h3 class="text-xl font-bold text-[rgb(33,48,118)] mb-3 group-hover:text-[rgb(67,97,238)] transition-colors">VSM &amp; Flow Engineering Facilitation Training</h3>
              <p class="text-gray-600 mb-6">Learn to run full VSM workshops yourself. Templates, coaching, and your team's real challenges.</p>
              <span data-cta class="inline-block bg-[rgb(67,97,238)] hover:bg-[rgb(67,97,238)]/90 text-white font-semibold py-2 px-4 rounded-lg text-sm transition-colors">Learn more</span>
            </div>
          </a>
        </div>
      </div>
    </section>

    <!-- How We Work Section -->
    <section id="how-we-work" class="py-20 px-4 bg-[#001C46]">
      <div class="max-w-6xl mx-auto">
        <!-- Resources Carousel -->
        <h2 class="text-3xl md:text-4xl font-bold text-center mb-8 text-white">Resources</h2>
        <div class="relative mb-16" data-resources-carousel>
          <ResourceCards />
        </div>
      </div>
    </section>

    <!-- What Clients Say Section -->
    <section id="testimonial" class="py-20 px-4 bg-[rgb(240,242,245)]">
      <div class="max-w-6xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-bold text-center mb-12 text-[rgb(33,48,118)]">What Clients Say</h2>
        <div class="grid md:grid-cols-2 gap-8">
          {testimonials.map(testimonial => (
            <blockquote class="bg-white p-8 rounded-lg shadow-md">
              <div class="text-gray-600 mb-6 text-lg italic">
                <p set:html={`&ldquo;${testimonial.quote}&rdquo;`} />
              </div>
              <footer class="space-y-4">
                <div class="flex items-center gap-4">
                  <div>
                    <cite class="text-[rgb(33,48,118)] font-bold not-italic">{testimonial.name}</cite>
                    <p class="text-gray-500">{testimonial.role}</p>
                  </div>
                </div>
                <a
                  href={`/blog/${testimonial.postSlug}`}
                  data-track-testimonial={testimonial.name.toLowerCase().replace(/\s+/g, '-')}
                  class="inline-block text-[rgb(67,97,238)] hover:text-[rgb(67,97,238)]/90 font-medium transition-colors"
                >
                  Read Full Testimonial &rarr;
                </a>
              </footer>
            </blockquote>
          ))}
        </div>
      </div>
    </section>

    <!-- Results Section -->
    <section id="results" class="py-20 px-4 bg-[rgb(240,242,245)]">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-bold text-center mb-2 text-[rgb(33,48,118)]">What You Can Achieve</h2>
        <p class="text-center text-gray-500 mb-12">Quick wins in hours, not weeks</p>

        <!-- Metrics row: 4 across on desktop, 2x2 on mobile -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-5 mb-12">
          <div class="text-center">
            <p class="text-4xl md:text-5xl font-bold text-[rgb(67,97,238)] mb-1">+20%</p>
            <p class="font-semibold text-[rgb(33,48,118)] text-base">capacity</p>
            <p class="text-sm text-gray-500">(no hiring)</p>
          </div>
          <div class="text-center">
            <p class="text-4xl md:text-5xl font-bold text-[rgb(67,97,238)] mb-1">+60%</p>
            <p class="font-semibold text-[rgb(33,48,118)] text-base">faster delivery</p>
            <p class="text-sm text-gray-500">(prev. clients)</p>
          </div>
          <div class="text-center">
            <p class="text-4xl md:text-5xl font-bold text-[rgb(67,97,238)] mb-1">&minus;20%</p>
            <p class="font-semibold text-[rgb(33,48,118)] text-base">production defects</p>
          </div>
          <div class="text-center">
            <p class="text-2xl md:text-3xl font-bold text-[rgb(67,97,238)] mb-1 leading-tight">Release on demand</p>
            <p class="text-sm text-gray-500">(ex: monthly &gt; weekly)</p>
          </div>
        </div>

        <!-- Photo proof strip -->
        <div class="flex gap-3 md:gap-4 justify-center">
          <div class="w-1/4 max-w-[180px] rounded-xl overflow-hidden aspect-[4/3] shadow-md"><img src="/images/landing/IMG-20250709-WA0012.jpg" alt="Workshop session" class="w-full h-full object-cover" data-results-photo /></div>
          <div class="w-1/4 max-w-[180px] rounded-xl overflow-hidden aspect-[4/3] shadow-md"><img src="/images/landing/IMG20250603202116.jpg" alt="Workshop collaboration" class="w-full h-full object-cover" data-results-photo /></div>
          <div class="w-1/4 max-w-[180px] rounded-xl overflow-hidden aspect-[4/3] shadow-md"><img src="/images/landing/IMG20251013185120.jpg" alt="Workshop facilitation" class="w-full h-full object-cover" data-results-photo /></div>
          <div class="w-1/4 max-w-[180px] rounded-xl overflow-hidden aspect-[4/3] shadow-md"><img src="/images/landing/img_4824_54644818637_o.jpg" alt="Workshop participants" class="w-full h-full object-cover" data-results-photo /></div>
        </div>
      </div>
    </section>

    <!-- Bottom CTA Section -->
    <section id="contact" class="py-20 px-4 bg-[rgb(67,97,238)] text-white">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="text-3xl md:text-4xl font-bold mb-4">Start with a 1h30 Introduction to VSM</h2>
        <p class="text-xl mb-2">Hands-on session for engineering and product leaders.</p>
        <p class="text-white/80 text-lg mb-8">&euro;50 per person &middot; Only 10 spots per session</p>
        <a href="/workshops/intro" data-bottom-cta="intro" class="inline-block bg-white hover:bg-white/90 text-[rgb(67,97,238)] font-bold py-3 px-8 rounded-lg text-lg transition-colors">
          See details
        </a>
        <p class="mt-6 text-white/70 text-sm">
          Need something tailored?
          <a href="https://calendly.com/migueldiaseu" target="_blank" rel="noopener noreferrer" data-track-book-call="bottom-cta" class="underline text-white hover:text-white/90">Book a call</a>
        </p>
      </div>
    </section>
  </main>
</Layout>
