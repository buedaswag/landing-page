---
import Layout from '../layouts/Layout.astro';

const services = [
  {
    title: "Improve Your Release Process",
    description: "Identify bottlenecks, handoffs, dependencies, and address them for smoother, more predictable releases.",
    icon: `<svg class="w-12 h-12" fill="currentColor" viewBox="0 0 24 24"><path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 14l-5-5 1.41-1.41L11 13.17l6.59-6.59L19 8l-7 9z"/></svg>`
  },
  {
    title: "Deliver Reliable, High-Quality Software",
    description: "Build quality at the source and minimize defects before they reach customers.",
    icon: `<svg class="w-12 h-12" fill="currentColor" viewBox="0 0 24 24"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z"/></svg>`
  },
  {
    title: "Release Often and Stay Competitive",
    description: "Improving work saves time and compounds over time, freeing up your teams to deliver value and stay ahead of the competition.",
    icon: `<svg class="w-12 h-12" fill="currentColor" viewBox="0 0 24 24"><path d="M11.8 10.9c-2.27-.59-3-1.2-3-2.15 0-1.09 1.01-1.85 2.7-1.85 1.78 0 2.44.85 2.5 2.1h2.21c-.07-1.72-1.12-3.3-3.21-3.81V3h-3v2.16c-1.94.42-3.5 1.68-3.5 3.61 0 2.31 1.91 3.46 4.7 4.13 2.5.6 3 1.48 3 2.41 0 .69-.49 1.79-2.7 1.79-2.06 0-2.87-.92-2.98-2.1h-2.2c.12 2.19 1.76 3.42 3.68 3.83V21h3v-2.15c1.95-.37 3.5-1.5 3.5-3.55 0-2.84-2.43-3.81-4.7-4.4z"/></svg>`
  },
  {
    title: "Align Teams on Shared Goals",
    description: "Set clear metrics for customer value. Everyone knows what success looks like and how to achieve it.",
    icon: `<svg class="w-12 h-12" fill="currentColor" viewBox="0 0 24 24"><path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zM9 17H7v-7h2v7zm4 0h-2V7h2v10zm4 0h-2v-4h2v4z"/></svg>`
  }
];

const process = [
  {
    title: "Planning & Alignment",
    steps: [
      "We clarify your improvement needs, objectives, where the biggest constraints lie, and involve key stakeholders from the start."
    ]
  },
  {
    title: "Workshop Sessions",
    steps: [
      "Visualize and measure your workflows, spotting bottlenecks and dependencies, enabling powerful conversations about how to improve."
    ]
  },
  {
    title: "Improvement Roadmap",
    steps: [
      "Prioritize Initiatives: Your teams build a plan with clear actions, owners, timelines, and measurable goals."
    ]
  },
  {
    title: "Implementation & Ongoing Support",
    steps: [
      "Regular Check-ins: We review progress, address blockers, and refine actions as needed."
    ]
  }
];

const testimonials = [
  {
    name: "Mika",
    role: "Director of Engineering",
    quote: "The value stream mapping Miguel organized for our engineering team revealed how our deployment process could improve and served as a powerful team-building exercise. Everyone got on the same page, understanding what we're good at and what needs work. Empowering the team to set realistic targets, based on real analysis, motivated us to reach those targets—and exceed them. It's a great example of a team taking control of its ways of working."
  }
];
---

<Layout title="Miguel Dias - DevOps & Value Stream Mapping Expert">
  <main>
    <!-- Hero Section -->
    <section class="hero py-24 flex items-center justify-center bg-white text-[rgb(33,48,118)] px-4">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-4xl md:text-6xl font-bold mb-4">
          Improve Your Software<br />
          Delivery
        </h1>
        <p class="text-lg md:text-xl mb-6 text-[rgb(33,48,118)]/90 max-w-2xl mx-auto">
          I help organizations deploy software more often, with higher quality and fewer problems with Value Stream Mapping and DevOps.
        </p>
        <a href="#contact" class="inline-block bg-[rgb(67,97,238)] hover:bg-[rgb(67,97,238)]/90 text-white font-bold py-3 px-8 rounded-lg text-lg transition-colors">
          Let's Talk About Improvements
        </a>
      </div>
    </section>

    <!-- Process Section -->
    <section class="py-20 px-4 bg-[#001C46]">
      <div class="max-w-6xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-bold text-center mb-12 text-white">How We Work</h2>
        <div class="grid md:grid-cols-2 gap-12">
          {process.map((step, index) => (
            <div class="bg-[#001C46]/20 p-8 rounded-lg border border-white/10">
              <div class="flex items-center gap-4 mb-4">
                <span class="w-8 h-8 flex items-center justify-center bg-white text-[#001C46] rounded-full font-bold">
                  {index + 1}
                </span>
                <h3 class="text-xl font-bold text-white">{step.title}</h3>
              </div>
              <ul class="space-y-3">
                {step.steps.map(item => (
                  <li class="text-white/80">{item}</li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Testimonials Section -->
    <section class="py-20 px-4 bg-[rgb(240,242,245)]">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-bold text-center mb-12 text-[rgb(33,48,118)]">What Clients Say</h2>
        {testimonials.map(testimonial => (
          <blockquote class="bg-white p-8 rounded-lg shadow-md">
            <p class="text-gray-600 mb-6 text-lg italic">"{testimonial.quote}"</p>
            <footer class="flex items-center gap-4">
              <div>
                <cite class="text-[rgb(33,48,118)] font-bold not-italic">{testimonial.name}</cite>
                <p class="text-gray-500">{testimonial.role}</p>
              </div>
            </footer>
          </blockquote>
        ))}
      </div>
    </section>

    <!-- Services Section -->
    <section class="py-20 px-4 bg-white">
      <div class="max-w-6xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-bold text-center mb-12 text-[rgb(33,48,118)]">What I Help You Achieve</h2>
        <div class="grid md:grid-cols-2 gap-12">
          <div class="flex gap-6">
            <div class="flex-shrink-0 w-12 h-12 text-[rgb(67,97,238)]">
              <svg class="w-12 h-12" fill="currentColor" viewBox="0 0 24 24">
                <path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 14l-5-5 1.41-1.41L11 13.17l6.59-6.59L19 8l-7 9z"/>
              </svg>
            </div>
            <div>
              <h3 class="text-xl font-bold mb-3 text-[rgb(33,48,118)]">Improve Your Release Process</h3>
              <p class="text-gray-600">Identify bottlenecks, handoffs, dependencies, and address them for smoother, more predictable releases.</p>
            </div>
          </div>
          <div class="flex gap-6">
            <div class="flex-shrink-0 w-12 h-12 text-[rgb(67,97,238)]">
              <svg class="w-12 h-12" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z"/>
              </svg>
            </div>
            <div>
              <h3 class="text-xl font-bold mb-3 text-[rgb(33,48,118)]">Deliver Reliable, High-Quality Software</h3>
              <p class="text-gray-600">Build quality at the source and minimize defects before they reach customers.</p>
            </div>
          </div>
          <div class="flex gap-6">
            <div class="flex-shrink-0 w-12 h-12 text-[rgb(67,97,238)]">
              <svg class="w-12 h-12" fill="currentColor" viewBox="0 0 24 24">
                <path d="M11.8 10.9c-2.27-.59-3-1.2-3-2.15 0-1.09 1.01-1.85 2.7-1.85 1.78 0 2.44.85 2.5 2.1h2.21c-.07-1.72-1.12-3.3-3.21-3.81V3h-3v2.16c-1.94.42-3.5 1.68-3.5 3.61 0 2.31 1.91 3.46 4.7 4.13 2.5.6 3 1.48 3 2.41 0 .69-.49 1.79-2.7 1.79-2.06 0-2.87-.92-2.98-2.1h-2.2c.12 2.19 1.76 3.42 3.68 3.83V21h3v-2.15c1.95-.37 3.5-1.5 3.5-3.55 0-2.84-2.43-3.81-4.7-4.4z"/>
              </svg>
            </div>
            <div>
              <h3 class="text-xl font-bold mb-3 text-[rgb(33,48,118)]">Release Often and Stay Competitive</h3>
              <p class="text-gray-600">Improving work saves time and compounds over time, freeing up your teams to deliver value and stay ahead of the competition.</p>
            </div>
          </div>
          <div class="flex gap-6">
            <div class="flex-shrink-0 w-12 h-12 text-[rgb(67,97,238)]">
              <svg class="w-12 h-12" fill="currentColor" viewBox="0 0 24 24">
                <path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zM9 17H7v-7h2v7zm4 0h-2V7h2v10zm4 0h-2v-4h2v4z"/>
              </svg>
            </div>
            <div>
              <h3 class="text-xl font-bold mb-3 text-[rgb(33,48,118)]">Align Teams on Shared Goals</h3>
              <p class="text-gray-600">Set clear metrics for customer value. Everyone knows what success looks like and how to achieve it.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Case Study Section -->
    <section class="py-20 px-4 bg-white">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-bold text-center mb-12 text-[rgb(33,48,118)]">Example Project Results</h2>
        <div class="bg-[rgb(240,242,245)] p-8 rounded-lg">
          <h3 class="text-xl font-bold mb-4 text-[rgb(33,48,118)]">The Challenge</h3>
          <p class="text-gray-600 mb-8">
            A cross-functional team relied on one or two developers to handle production deployments, leading to long lead times—around 28 days on average—and inconsistent release schedules. Key issues often weren't caught until late in the process, creating extra work and delays.
          </p>

          <h3 class="text-xl font-bold mb-4 text-[rgb(33,48,118)]">Our Approach</h3>
          <ul class="list-disc list-inside text-gray-600 mb-8 space-y-2">
            <li>Value Stream Mapping Workshop: We facilitated collaborative mapping sessions to understand the deployment process, identifying bottlenecks, handoffs, and communication gaps.</li>
            <li>Team Empowerment: All developers in the team now know the process for deploying changes and are empowered to deploy.</li>
            <li>Predictable Release Cadence: Collaborated with change management to set weekly deployment windows.</li>
          </ul>

          <h3 class="text-xl font-bold mb-4 text-[rgb(33,48,118)]">The Outcome</h3>
          <ul class="list-disc list-inside text-gray-600 space-y-2">
            <li>64% Lead Time Reduction: Time from code completion to live deployment dropped from 28 to 10 days.</li>
            <li>Higher Deployment Frequency: Releases now happen weekly or every other week instead of monthly.</li>
            <li>Team Ownership: Every developer understands the deployment process and can execute it.</li>
            <li>Fewer Surprises: Shifting quality checks earlier means potential issues are found sooner.</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- About Section -->
    <section class="py-20 px-4 bg-white">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-bold text-center mb-12 text-[rgb(33,48,118)]">I'm a Lean Management & DevOps Consultant</h2>
        <div class="text-gray-600 space-y-6">
          <p>
            I help organizations improve complex release processes so they can deliver consistent customer value. I bring practical experience in Lean Management, DevOps, Cloud Infrastructure, Data Engineering, and Analytics, to solve your unique challenges.
          </p>
          <p>
            Let's work together to address dependencies, improve quality at the source, and create a faster, more reliable software delivery process.
          </p>
        </div>
      </div>
    </section>

    <!-- Contact Section -->
    <section id="contact" class="py-20 px-4 bg-[rgb(67,97,238)] text-white">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="text-3xl md:text-4xl font-bold mb-6">Ready to Improve Your Software Delivery?</h2>
        <p class="text-xl mb-8">
          Whether you're a small team or a large organization, Value Stream Mapping can help you release features more often, discover problems earlier, and improve cross-team collaboration.
        </p>
        <a href="mailto:miguel@migueldias.eu" class="inline-block bg-white hover:bg-white/90 text-[rgb(67,97,238)] font-bold py-3 px-8 rounded-lg text-lg transition-colors">
          Let's Talk About Improvements
        </a>
      </div>
    </section>
  </main>
</Layout>
