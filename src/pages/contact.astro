---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact - Miguel Dias">
  <main>
    <section class="py-24 px-4">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-4xl md:text-5xl font-bold mb-8 text-[rgb(33,48,118)]">Book a Call</h1>

        <div class="space-y-12">
          <!-- Calendly -->
          <div>
            <h2 class="text-2xl font-bold mb-4 text-[rgb(33,48,118)]">Schedule a Call</h2>
            <a
              href="https://calendly.com/migueldiaseu"
              target="_blank"
              rel="noopener noreferrer"
              data-track-book-call="contact"
              class="inline-block bg-[rgb(67,97,238)] hover:bg-[rgb(67,97,238)]/90 text-white font-bold py-3 px-8 rounded-lg text-lg transition-colors"
            >
              Book a Call
            </a>
          </div>

          <!-- Email -->
          <div>
            <h2 class="text-2xl font-bold mb-4 text-[rgb(33,48,118)]">Email Me</h2>
            <a href="mailto:miguel@migueldias.eu" class="text-[rgb(67,97,238)] text-xl hover:text-[rgb(67,97,238)]/90 transition-colors">
              miguel@migueldias.eu
            </a>
          </div>

          <!-- LinkedIn -->
          <div>
            <h2 class="text-2xl font-bold mb-4 text-[rgb(33,48,118)]">Connect on LinkedIn</h2>
            <a
              href="https://www.linkedin.com/in/migueldiaseu/"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 text-[rgb(67,97,238)] hover:text-[rgb(67,97,238)]/90 transition-colors"
            >
              <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
              </svg>
              <span class="text-lg">Miguel Dias</span>
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>
