---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Privacy Policy - Miguel Dias">
  <main class="py-24 px-4">
    <div class="max-w-4xl mx-auto">
      <h1 class="text-4xl md:text-5xl font-bold mb-8 text-[rgb(33,48,118)] text-center">Privacy Policy</h1>

      <div class="prose max-w-none text-gray-600 space-y-6">
        <p class="text-lg">
          This website does not collect any personal information. It does not use cookies or any form of tracking.
        </p>

        <p class="text-lg">
          When you schedule a call through Calendly or connect through LinkedIn, you will be directed to their respective platforms,
          which have their own privacy policies.
        </p>

        <p class="text-lg">
          For any questions about privacy, you can contact me at miguel@migueldias.eu
        </p>
      </div>
    </div>
  </main>
</Layout>
