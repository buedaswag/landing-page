---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Privacy Policy - Miguel Dias">
  <main class="py-24 px-4">
    <div class="max-w-4xl mx-auto">
      <h1 class="text-4xl md:text-5xl font-bold mb-8 text-[rgb(33,48,118)] text-center">Privacy Policy</h1>

      <div class="prose max-w-none text-gray-600 space-y-6">
        <p class="text-lg">
          This website uses cookies only after you give consent via the cookie banner.
        </p>

        <p class="text-lg">
          A preference cookie (<code class="bg-gray-100 px-1 rounded">cookie_consent</code>) remembers your choice for 1 year.
          If you accept, <a href="https://policies.google.com/privacy" target="_blank" rel="noopener noreferrer" class="text-[rgb(67,97,238)] hover:underline">Google Analytics</a> cookies (<code class="bg-gray-100 px-1 rounded">_ga</code>, <code class="bg-gray-100 px-1 rounded">_ga_*</code>) collect anonymous usage data such as pages visited, referral source, device type, and button clicks.
        </p>

        <p class="text-lg">
          You can change your preference at any time using the "Manage Cookies" link in the footer, or by clearing cookies in your browser settings.
        </p>

        <p class="text-lg">
          Calendly and LinkedIn have their own privacy policies when you use those services.
        </p>

        <p class="text-lg">
          Contact: <a href="mailto:miguel@migueldias.eu" class="text-[rgb(67,97,238)] hover:underline">miguel@migueldias.eu</a>
        </p>
      </div>
    </div>
  </main>
</Layout>
