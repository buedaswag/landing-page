---
---
<nav class="fixed top-0 left-0 right-0 z-50 backdrop-blur-sm border-b border-white/10">
  <div class="bg-white/95">
    <div class="nav-content">
      <div class="left-links">
        <a href="/about">About</a>
        <a href="/blog">Blog</a>
        <a href="/contact">Contact</a>
      </div>

      <a href="/" class="site-title">Miguel Dias</a>

      <div class="social-links">
        <a href="https://linkedin.com/in/migueldiaseu" target="_blank" rel="noopener" class="social-link">
          <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
</nav>

<style>
  nav {
    transition: background-color 0.3s ease;
  }

  .nav-content {
    max-width: var(--max-width);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 2rem;
    padding: 1rem;
  }

  .left-links {
    display: flex;
    gap: 1.5rem;
  }

  .left-links a {
    color: rgb(var(--primary));
    text-decoration: none;
    font-weight: 500;
  }

  .left-links a:hover {
    color: rgb(var(--accent));
  }

  .site-title {
    font-size: 1.5rem;
    font-weight: 700;
    text-decoration: none;
    color: rgb(var(--accent));
    text-align: center;
  }

  .social-links {
    display: flex;
    justify-content: flex-end;
  }

  .social-link {
    color: rgb(var(--primary));
    display: flex;
    align-items: center;
    transition: color 0.2s;
  }

  .social-link:hover {
    color: rgb(var(--accent));
  }

  .w-6 {
    width: 1.5rem;
  }

  .h-6 {
    height: 1.5rem;
  }

  @media (max-width: 640px) {
    .nav-content {
      grid-template-columns: 1fr;
      gap: 1rem;
      text-align: center;
    }

    .left-links, .social-links {
      justify-content: center;
    }
  }
</style>
