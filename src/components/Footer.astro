---
const currentYear = new Date().getFullYear();
---

<footer class="py-16 px-4 bg-white">
  <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-4 gap-12">
    <!-- Brand -->
    <div>
      <a href="/" class="text-xl font-bold text-[rgb(33,48,118)]">Miguel Dias</a>
    </div>

    <!-- Navigation -->
    <div>
      <h3 class="font-bold text-[rgb(33,48,118)] mb-4">Navigation</h3>
      <ul class="space-y-2">
        <li><a href="/about" class="text-gray-600 hover:text-[rgb(67,97,238)]">About</a></li>
        <li><a href="/blog" class="text-gray-600 hover:text-[rgb(67,97,238)]">Blog</a></li>
        <li><a href="/contact" class="text-gray-600 hover:text-[rgb(67,97,238)]">Contact</a></li>
      </ul>
    </div>

    <!-- Contact -->
    <div>
      <h3 class="font-bold text-[rgb(33,48,118)] mb-4">Contact</h3>
      <ul class="space-y-2">
        <li>
          <a href="mailto:miguel@migueldias.eu" class="text-gray-600 hover:text-[rgb(67,97,238)]">
            miguel@migueldias.eu
          </a>
        </li>
        <li>
          <a href="https://calendly.com/migueldiaseu" target="_blank" rel="noopener noreferrer" class="text-gray-600 hover:text-[rgb(67,97,238)]">
            Book a Call
          </a>
        </li>
      </ul>
    </div>

    <!-- Social -->
    <div>
      <h3 class="font-bold text-[rgb(33,48,118)] mb-4">Follow</h3>
      <a
        href="https://www.linkedin.com/in/migueldias1212/"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 text-gray-600 hover:text-[rgb(67,97,238)]"
      >
        <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
          <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
        </svg>
        <span>LinkedIn</span>
      </a>
    </div>
  </div>

  <!-- Bottom Section -->
  <div class="max-w-7xl mx-auto mt-12 pt-8 border-t border-gray-200">
    <div class="flex flex-col md:flex-row justify-between items-center gap-4">
      <p class="text-gray-600">© {currentYear} Miguel Dias</p>
      <div class="flex gap-8">
        <a href="/privacy" class="text-gray-600 hover:text-[rgb(67,97,238)]">Privacy Policy</a>
        <a href="/terms" class="text-gray-600 hover:text-[rgb(67,97,238)]">Terms of Service</a>
      </div>
    </div>
  </div>
</footer>
