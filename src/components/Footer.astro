---
const currentYear = new Date().getFullYear();
---

<footer class="py-16 px-4 bg-white">
  <div class="max-w-7xl mx-auto">
    <!-- Main Footer Content -->
    <div class="grid grid-cols-1 md:grid-cols-5 gap-12 mb-12">
      <!-- Brand -->
      <div>
        <a href="/" class="text-xl font-bold text-[rgb(33,48,118)]">Miguel Dias</a>
      </div>

      <!-- Work Together -->
      <div>
        <h3 class="font-bold text-[rgb(33,48,118)] mb-4">Work Together</h3>
        <ul class="space-y-2">
          <li><a href="/#how-we-work" class="text-gray-600 hover:text-[rgb(67,97,238)]" onclick="document.querySelector('#how-we-work').scrollIntoView({ behavior: 'smooth' })">Resources</a></li>
          <li><a href="/#case-study" class="text-gray-600 hover:text-[rgb(67,97,238)]" onclick="document.querySelector('#case-study').scrollIntoView({ behavior: 'smooth' })">Case Study</a></li>
          <li><a href="/#testimonial" class="text-gray-600 hover:text-[rgb(67,97,238)]" onclick="document.querySelector('#testimonial').scrollIntoView({ behavior: 'smooth' })">Testimonial</a></li>
        </ul>
      </div>

      <!-- Blog -->
      <div>
        <h3 class="font-bold text-[rgb(33,48,118)] mb-4">Blog</h3>
        <ul class="space-y-2">
          <li><a href="/blog" class="text-gray-600 hover:text-[rgb(67,97,238)]">Latest Posts</a></li>
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h3 class="font-bold text-[rgb(33,48,118)] mb-4">Contact</h3>
        <ul class="space-y-2">
          <li><a href="/contact" class="text-gray-600 hover:text-[rgb(67,97,238)]">Get in Touch</a></li>
          <li><a href="https://calendly.com/migueldiaseu" target="_blank" rel="noopener noreferrer" data-track-book-call="footer" class="text-gray-600 hover:text-[rgb(67,97,238)]">Book a Call</a></li>
        </ul>
      </div>

      <!-- LinkedIn -->
      <div>
        <h3 class="font-bold text-[rgb(33,48,118)] mb-4">LinkedIn</h3>
        <a
          href="https://www.linkedin.com/in/migueldiaseu/"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 text-gray-600 hover:text-[rgb(67,97,238)]"
        >
          <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
            <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
          </svg>
          <span>Connect</span>
        </a>
      </div>
    </div>

    <!-- Bottom Info -->
    <div class="flex flex-col md:flex-row justify-between items-center gap-2">
      <p class="text-gray-600">© {currentYear} Miguel Dias</p>
      <div class="flex items-center gap-4">
        <button id="manage-cookies" class="text-gray-600 hover:text-[rgb(67,97,238)] cursor-pointer bg-transparent border-none p-0">Manage Cookies</button>
        <a href="/privacy" class="text-gray-600 hover:text-[rgb(67,97,238)]">Privacy Policy</a>
      </div>
    </div>
  </div>
</footer>
