---
interface Props {
  title: string;
  description: string;
  date: string;
  url: string;
  image?: string;
  base: string;
}

const { title, description, date, url, image, base } = Astro.props;

const formattedImage = image ? `${base}${image}` : null;
const formattedDate = new Date(date).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});
---

<article class="post-preview">
  <div class="post-header">
    <h2>
      <a href={url}>{title}</a>
    </h2>
    <time datetime={date}>{formattedDate}</time>
  </div>

  <div class="post-content">
    {formattedImage && (
      <div class="image">
        <a href={url}>
          <img src={formattedImage} alt={`Preview for ${title}`} loading="lazy" decoding="async" />
        </a>
      </div>
    )}
    <p>{description}</p>
  </div>
</article>

<style>
  .post-preview {
    margin-bottom: 3rem;
  }
  .post-header {
    margin-bottom: 1.5rem;
  }
  h2 {
    font-size: 1.75rem;
    line-height: 1.3;
    margin-bottom: 0.5rem;
  }
  h2 a {
    color: var(--text-color);
    text-decoration: none;
  }
  h2 a:hover {
    color: var(--link-color);
  }
  time {
    color: #666;
    font-size: 0.9rem;
  }
  .post-content {
    display: grid;
    gap: 1.5rem;
  }
  p {
    color: #444;
    font-size: 1.1rem;
  }
  .image img {
    width: 100%;
    aspect-ratio: 16/9;
    object-fit: cover;
    transition: transform 0.2s;
  }
  .image img:hover {
    transform: scale(1.02);
  }
  @media (max-width: 768px) {
    h2 {
      font-size: 1.5rem;
    }
  }
</style>
