---
interface Props {
  title: string;
  description: string;
  date: string;
  url: string;
  image?: string;
  base: string;
  draft?: boolean;
}

const { title, description, date, url, image, base, draft } = Astro.props;
const displayTitle = import.meta.env.DEV && draft ? `DRAFT: ${title}` : title;

// Remove base from image path as it's causing issues
const formattedImage = image;
const formattedDate = new Date(date).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});
---

<article class="post-preview" data-post-url={url}>
  <a href={url} class="post-link">
    <h2>{displayTitle}</h2>
    <time datetime={date}>{formattedDate}</time>
    {formattedImage && (
      <div class="image-container">
        <img src={formattedImage} alt={`Preview for ${title}`} loading="lazy" decoding="async" />
      </div>
    )}
    <p>{description}</p>
  </a>
</article>

<style>
  .post-preview {
    width: 100%;
    max-width: 42rem;
    margin: 0 auto 4rem;
  }

  .post-link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  h2 {
    font-size: 1.75rem;
    font-weight: 700;
    line-height: 1.2;
    margin-bottom: 0.5rem;
    color: var(--text-color);
    text-align: left;
  }

  time {
    display: block;
    color: #666;
    font-size: 1rem;
    margin-bottom: 1.5rem;
    text-align: left;
  }

  .image-container {
    width: 100%;
    margin-bottom: 1.5rem;
    overflow: hidden;
    position: relative;
    padding-top: 45%;
  }

  .image-container img {
    position: absolute;
    top: -10%;
    left: 0;
    width: 100%;
    height: 120%;
    object-fit: cover;
    display: block;
  }

  p {
    color: #4a5568;
    font-size: 1.125rem;
    line-height: 1.6;
    text-align: left;
  }

  @media (max-width: 768px) {
    h2 {
      font-size: 1.5rem;
    }

    p {
      font-size: 1rem;
    }
  }
</style>
