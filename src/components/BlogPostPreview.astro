---
interface Props {
  title: string;
  description: string;
  date: string;
  url: string;
  image?: string;
  base: string;
}

const { title, description, date, url, image, base } = Astro.props;

const formattedImage = image ? `${base}${image}` : null;
const formattedDate = new Date(date).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});
---

<article class="post-preview">
  <a href={url} class="post-link">
    {formattedImage && (
      <div class="image-container">
        <img src={formattedImage} alt={`Preview for ${title}`} loading="lazy" decoding="async" />
      </div>
    )}
    <div class="post-content">
      <h2>{title}</h2>
      <time datetime={date}>{formattedDate}</time>
      <p>{description}</p>
    </div>
  </a>
</article>

<style>
  .post-preview {
    margin-bottom: 4rem;
    max-width: 800px;
    margin-left: auto;
    margin-right: auto;
    text-align: center;
  }

  .post-link {
    display: block;
    text-decoration: none;
    color: inherit;
    transition: transform 0.2s;
  }

  .post-link:hover {
    transform: translateY(-2px);
  }

  .image-container {
    width: 100%;
    margin-bottom: 2rem;
    border-radius: 0.5rem;
    overflow: hidden;
  }

  .image-container img {
    width: 100%;
    height: 400px;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .post-link:hover .image-container img {
    transform: scale(1.03);
  }

  .post-content {
    padding: 0 1rem;
  }

  h2 {
    font-size: 2rem;
    font-weight: 600;
    line-height: 1.3;
    margin-bottom: 0.75rem;
    color: var(--text-color);
  }

  time {
    display: block;
    color: #666;
    font-size: 1rem;
    margin-bottom: 1rem;
  }

  p {
    color: #444;
    font-size: 1.2rem;
    line-height: 1.6;
    max-width: 600px;
    margin: 0 auto;
  }

  @media (max-width: 768px) {
    h2 {
      font-size: 1.75rem;
    }

    .image-container img {
      height: 300px;
    }

    p {
      font-size: 1.1rem;
    }
  }
</style>
