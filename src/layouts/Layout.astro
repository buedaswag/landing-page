---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Miguel Dias. Improve your Software Delivery through Value Stream Mapping and DevOps practices." />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{title}</title>
	</head>
	<body class="min-h-screen flex flex-col pt-[72px]">
		<Header />
		<slot />
		<Footer />
	</body>
</html>

<style is:global>
	:root {
		--primary: 67, 97, 238;
		--secondary: 245, 180, 60;
		--accent: 33, 48, 118;
		--background: 240, 242, 245;
		--gradient: linear-gradient(
			45deg,
			rgb(var(--primary)),
			rgb(var(--secondary)) 100%
		);
	}
</style>
